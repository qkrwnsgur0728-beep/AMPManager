<UserControl x:Class="AMPManager.View.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource AppBackground}">

    <Grid>
        <Border Width="400" Height="450" Style="{StaticResource PanelStyle}" 
                Background="#2F2F3D" VerticalAlignment="Center" HorizontalAlignment="Center">

            <StackPanel VerticalAlignment="Center" Margin="40">
                <TextBlock Text="회원가입" Foreground="{StaticResource AccentColor}" 
                           FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <TextBlock Text="이름 (Name)" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,5"/>
                <TextBox Text="{Binding InputName}" Height="35" VerticalContentAlignment="Center" Padding="5,0" Margin="0,0,0,15"/>

                <TextBlock Text="아이디 (ID)" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,5"/>
                <TextBox Text="{Binding InputId}" Height="35" VerticalContentAlignment="Center" Padding="5,0" Margin="0,0,0,15"/>

                <TextBlock Text="비밀번호 (PW)" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtPw" Height="35" VerticalContentAlignment="Center" Padding="5,0" Margin="0,0,0,30"/>

                <Button Content="가입하기" 
                        Command="{Binding SignupCommand}" 
                        CommandParameter="{Binding ElementName=txtPw}"
                        Height="45" Background="{StaticResource AccentColor}" 
                        Foreground="White" FontWeight="Bold" FontSize="16" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>