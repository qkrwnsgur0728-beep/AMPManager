<UserControl x:Class="AMPManager.View.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource AppBackground}">

    <Grid Margin="40">
        <StackPanel HorizontalAlignment="Left">
            <TextBlock Text="관리자 계정 관리" 
                       Foreground="{StaticResource AccentColor}" 
                       FontSize="24" FontWeight="Bold" Margin="0,0,0,30"/>

            <Border Style="{StaticResource PanelStyle}" Padding="30" Width="400" HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Text="새 관리자 등록" Foreground="{StaticResource PrimaryText}" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

                    <TextBlock Text="아이디 (ID)" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding NewId}" Height="35" VerticalContentAlignment="Center" Padding="5,0"
                             Background="#3A3A4A" Foreground="White" BorderThickness="0" Margin="0,0,0,15">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <TextBlock Text="이름 (Name)" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding NewName}" Height="35" VerticalContentAlignment="Center" Padding="5,0"
                             Background="#3A3A4A" Foreground="White" BorderThickness="0" Margin="0,0,0,15">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <TextBlock Text="비밀번호 (Password)" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="NewPwBox" Height="35" VerticalContentAlignment="Center" Padding="5,0"
                                 Background="#3A3A4A" Foreground="White" BorderThickness="0" Margin="0,0,0,25">
                        <PasswordBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </PasswordBox.Resources>
                    </PasswordBox>

                    <Button Content="계정 생성" Command="{Binding CreateAdminCommand}" CommandParameter="{Binding ElementName=NewPwBox}"
                            Height="40" Background="{StaticResource AccentColor}" Foreground="White" FontWeight="Bold" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>