<Window x:Class="AMPManager.View.SignUpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="회원가입" Height="500" Width="360"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E2D" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True">

    <Border CornerRadius="15" BorderBrush="#4A4A5A" BorderThickness="1">
        <Grid Margin="30">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="회원가입" Foreground="#00C1D4" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="이름" Foreground="#B0B0B0" Margin="0,0,0,5"/>
                <TextBox Text="{Binding InputName}" Height="35" VerticalContentAlignment="Center" Background="#2F2F3D" Foreground="White" BorderThickness="0"/>

                <TextBlock Text="아이디" Foreground="#B0B0B0" Margin="0,15,0,5"/>
                <TextBox Text="{Binding InputId}" Height="35" VerticalContentAlignment="Center" Background="#2F2F3D" Foreground="White" BorderThickness="0"/>

                <TextBlock Text="비밀번호" Foreground="#B0B0B0" Margin="0,15,0,5"/>
                <PasswordBox x:Name="RegPwBox" Height="35" VerticalContentAlignment="Center" Background="#2F2F3D" Foreground="White" BorderThickness="0"/>

                <TextBlock Text="관리자 코드 (선택)" Foreground="#B0B0B0" Margin="0,15,0,5"/>
                <TextBox Text="{Binding InputAdminCode}" Height="35" VerticalContentAlignment="Center" Background="#2F2F3D" Foreground="White" BorderThickness="0"
                         ToolTip="관리자 계정 생성 시 '1234' 입력"/>

                <Button Content="가입하기" Command="{Binding RegisterCommand}" CommandParameter="{Binding ElementName=RegPwBox}"
                        Height="45" Margin="0,30,0,0" Background="#00C1D4" Foreground="White" FontWeight="Bold" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="22"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="취소" Click="BtnCancel_Click" 
                        Height="30" Width="60" Margin="0,15,0,0" Background="Transparent" Foreground="#FF5252" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>