<Window x:Class="AMPManager.View.LogDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        Title="상세 정보" Height="960" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E2D">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="2.5*"/>
            <RowDefinition Height="1.5*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.Resources>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#2F2F3D"/>
                    <Setter Property="Margin" Value="2"/>
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Grid.Resources>

            <Border Grid.Row="0" Grid.Column="0">
                <Image Source="{Binding Cam1Path}" Stretch="Uniform"/>
            </Border>
            <Border Grid.Row="0" Grid.Column="1">
                <Image Source="{Binding Cam2Path}" Stretch="Uniform"/>
            </Border>
            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                <TextBlock Text="No Additional Image" Foreground="#505060" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="#2F2F3D" CornerRadius="10" Padding="20" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="검사 상세 리포트" Foreground="#00C1D4" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                    </Grid.RowDefinitions>

                    <Grid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#B0B0B0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                        <Style x:Key="ValueText" TargetType="TextBlock">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                        <Style x:Key="LimitText" TargetType="TextBlock" BasedOn="{StaticResource ValueText}">
                            <Setter Property="Foreground" Value="#B0B0B0"/>
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Margin" Value="0,0,10,0"/>
                        </Style>
                    </Grid.Resources>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="검사 일시"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Timestamp}" Style="{StaticResource ValueText}"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="구멍 오프셋 (mm)"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding HoleOffset, StringFormat={}{0:F3} mm}" Style="{StaticResource ValueText}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="제품명"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PropertyName}" Style="{StaticResource ValueText}"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="측정 면적 (mm²)"/>
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding AreaSize, StringFormat={}{0:F2} mm²}" Style="{StaticResource ValueText}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="제품 ID"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Id}" Style="{StaticResource ValueText}"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="모델 점수"/>
                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding ModelScore, StringFormat={}{0:F4}}" Style="{StaticResource ValueText}"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="판정 결과"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Status}" Style="{StaticResource ValueText}" Foreground="{Binding StatusColor}"/>
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="불합격 기준" Style="{StaticResource LimitText}"/>
                    <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding LimitFail, StringFormat={}{0:F2}}" Style="{StaticResource ValueText}" Foreground="Red"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="비고 / 사유"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DefectReason}" Style="{StaticResource ValueText}"/>
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="경고 기준" Style="{StaticResource LimitText}"/>
                    <TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding LimitWarn, StringFormat={}{0:F2}}" Style="{StaticResource ValueText}" Foreground="Yellow"/>

                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="#2F2F3D" CornerRadius="10" Padding="20" Margin="0,0,0,10">
            <lvc:CartesianChart Series="{Binding ChartSeriesCollection}" 
                                Zoom="X" 
                                Hoverable="True">
                <lvc:CartesianChart.AxisX>
                    <lvc:Axis Title="측정 횟수" Labels="{Binding ChartLabels}"/>
                </lvc:CartesianChart.AxisX>
                <lvc:CartesianChart.AxisY>
                    <lvc:Axis Title="측정값 (Hole Offset)" LabelFormatter="{Binding YFormatter}"/>
                </lvc:CartesianChart.AxisY>
            </lvc:CartesianChart>
        </Border>

        <Button Grid.Row="3" Content="닫기" IsCancel="True" Height="40" Width="100" Margin="0,20,0,0"
                Background="#4A4A5A" Foreground="White" BorderThickness="0" FontWeight="Bold">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Window>